APP_ENV=production
APP_DEBUG=false
APP_URL=https://agrocloud-ilan.vercel.app
APP_KEY=

# Configure these as runtime environment variables in Vercel.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=agrocloud-production
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Laravel publishes to the Reverb process inside the same container.
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

# The browser connects through Vercel HTTPS and Caddy.
REVERB_CLIENT_HOST=agrocloud-ilan.vercel.app
REVERB_CLIENT_PORT=443
REVERB_CLIENT_SCHEME=https
REVERB_ALLOWED_ORIGINS=agrocloud-ilan.vercel.app

# Required across Vercel instances. Use a TCP Redis provider with pub/sub.
REVERB_SCALING_ENABLED=true
REVERB_SCALING_CHANNEL=agrocloud-production-reverb
REDIS_CLIENT=phpredis
REDIS_URL=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr

# Retain your production database and Cloudinary credentials in Vercel.
# Do not set CLOUDINARY_CA_BUNDLE to a Windows path.
