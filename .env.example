APP_NAME="AgroCloud AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=agrocloud
# DB_USERNAME=postgres
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# NO subas credenciales reales al repositorio.
# Formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# Opcional: solo para crear/actualizar un administrador inicial al ejecutar el seeder.
# Después de usarlo, puedes retirar AGROCLOUD_ADMIN_PASSWORD de tu .env.
AGROCLOUD_ADMIN_EMAIL=
AGROCLOUD_ADMIN_PASSWORD=
AGROCLOUD_ADMIN_NAME=Administrador
AGROCLOUD_ADMIN_LASTNAME=AgroCloud

# WebSockets con Laravel Reverb (opcionales hasta ejecutar install:broadcasting --reverb)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# Public browser endpoint; production defaults to APP_URL host, HTTPS, port 443.
# Set these only when using a separate WebSocket domain.
# REVERB_CLIENT_HOST=ws.example.com
# REVERB_CLIENT_PORT=443
# REVERB_CLIENT_SCHEME=https
# Allowed hostnames separated by commas; production defaults to APP_URL host.
# REVERB_ALLOWED_ORIGINS=agrocloud.example.com
REVERB_SCALING_ENABLED=false
# Production on Vercel requires a shared TCP Redis server (not a REST URL).
# REDIS_URL=rediss://default:password@redis.example.com:6379
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

VITE_APP_NAME="${APP_NAME}"

# Optional absolute path to a trusted CA bundle for Cloudinary HTTPS.
CLOUDINARY_CA_BUNDLE=
